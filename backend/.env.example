NODE_ENV=development
PORT=5000
MONGODB_URI=PASTE_YOUR_MONGODB_ATLAS_CONNECTION_STRING_HERE
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CRON_SECRET=change_this_secret_for_scheduled_jobs

# Admin Seed Account
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@medibridge.local
ADMIN_PASSWORD=Admin@12345

# Cookie & Email
COOKIE_SECURE=false
EMAIL_FROM="MediBridge <no-reply@medibridge.local>"

# Donation & Screening Policy (WHO guidelines recommend 1 year; configurable per institution policy)
MIN_REMAINING_SHELF_LIFE_DAYS=90
MAX_ITEMS_PER_DONATION=10
MAX_PHOTOS_PER_MEDICINE=4

# Scheduled Expiry Tracking & Cron Jobs (Phase 4)
ENABLE_INTERNAL_CRON=true
EXPIRY_CRON_SCHEDULE="10 0 * * *"
ALLOW_DEV_TIME_TRAVEL=false

# Pharmacist Verification (Phase 5)
VERIFICATION_CLAIM_TTL_MINUTES=60

# Geo Matching & Claims (Phase 6)
CLAIM_RESPONSE_TTL_HOURS=72
MAX_OPEN_REQUIREMENTS_PER_ORG=10
MAX_PENDING_CLAIMS_PER_ORG=5
GEO_RADII_KM="5,10,20"
DEFAULT_RADIUS_KM=10

# QR & Chain of Custody (Phase 7)
QR_SIGNING_SECRET=replace_with_a_secure_random_key_of_min_32_characters_in_production
HANDOVER_TOKEN_TTL_MINUTES=15
HANDOVER_REMINDER_DAYS=3
HANDOVER_AUTO_CANCEL_DAYS=14
HANDOVER_TOKEN_MAX_ATTEMPTS=5

# Optional: Email configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
